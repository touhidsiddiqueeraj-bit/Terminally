<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal Academy launcher glyph: the ">_" prompt, drawn in the 108dp
     adaptive-icon viewport (content kept inside the 66dp safe zone). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- > chevron -->
    <path
        android:pathData="M38,42 L52,54 L38,66"
        android:strokeColor="#22E394"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000" />

    <!-- _ underscore -->
    <path
        android:pathData="M56,62 L74,62"
        android:strokeColor="#22E394"
        android:strokeWidth="6"
        android:strokeLineCap="square"
        android:fillColor="#00000000" />
</vector>
